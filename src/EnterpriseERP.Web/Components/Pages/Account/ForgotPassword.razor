@page "/account/forgot-password"
@layout AccountLayout
@attribute [AllowAnonymous]
<PageTitle>Password recovery</PageTitle>
<div class="login-card"><h1>Forgot password?</h1><p>Email is disabled in this local installation. Contact your administrator to verify your identity and arrange a password reset.</p><p>An administrator can reset an ordinary user account from Users. Bootstrap administrator recovery requires a separate controlled recovery operation.</p><a href="/account/login">Return to sign in</a></div>
