@inherits LayoutComponentBase
<div class="page"><aside class="sidebar"><NavMenu /></aside><main>
    <div class="top-row px-4"><span>ERP workspace</span><AuthorizeView><Authorized>
        <details class="profile-menu"><summary>@context.User.Identity?.Name</summary><div>
            <AuthorizeView Roles="SuperAdmin"><Authorized Context="roleContext"><small>SuperAdmin</small></Authorized></AuthorizeView>
            <form method="post" action="/account/logout" data-enhance="false"><AntiforgeryToken /><button type="submit" class="btn btn-link">Sign out</button></form>
        </div></details>
    </Authorized></AuthorizeView></div>
    <article class="content px-4">@Body</article>
</main></div>
<div id="blazor-error-ui" data-nosnippet>An unexpected error occurred. <a href="." class="reload">Reload</a><span class="dismiss">🗙</span></div>
